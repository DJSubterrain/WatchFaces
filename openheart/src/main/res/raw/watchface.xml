<?xml version="1.0" encoding="utf-8"?>
<!-- Open Heart: navy satin dial, big open-heart window with a balance wheel, silver hands, red seconds hand.
     Reference size 450x450; Watch Face Format scales it to the watch's screen. -->
<WatchFace width="450" height="450">

  <UserConfigurations>
    <BooleanConfiguration id="show_seconds"
        displayName="show_seconds_label"
        screenReaderText="show_seconds_label"
        defaultValue="TRUE" />
  </UserConfigurations>

  <Scene backgroundColor="#ff000000">

    <!-- Movement plate, seen through the window in the dial. -->
    <Group name="plate" x="0" y="0" width="450" height="450">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <PartImage x="145" y="60" width="160" height="160">
        <Image resource="plate" />
      </PartImage>
    </Group>

    <!-- Gears: each steps round once per second; their edges run off beneath the dial. -->
    <Group name="gear0" x="135" y="135" width="90" height="90" pivotX="0.5" pivotY="0.5">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Transform target="angle" value="[SECOND] * 6" />
      <PartImage x="0" y="0" width="90" height="90">
        <Image resource="gear0" />
      </PartImage>
    </Group>
    <Group name="gear1" x="233" y="147" width="78" height="78" pivotX="0.5" pivotY="0.5">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Transform target="angle" value="0 - [SECOND] * 6" />
      <PartImage x="0" y="0" width="78" height="78">
        <Image resource="gear1" />
      </PartImage>
    </Group>
    <Group name="gear2" x="155" y="65" width="62" height="62" pivotX="0.5" pivotY="0.5">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Transform target="angle" value="[SECOND] * 12" />
      <PartImage x="0" y="0" width="62" height="62">
        <Image resource="gear2" />
      </PartImage>
    </Group>
    <Group name="gear3" x="249" y="69" width="54" height="54" pivotX="0.5" pivotY="0.5">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Transform target="angle" value="0 - [SECOND] * 12" />
      <PartImage x="0" y="0" width="54" height="54">
        <Image resource="gear3" />
      </PartImage>
    </Group>

    <!-- Balance wheel: swings back and forth once every second, in step with the seconds hand. -->
    <Group name="balance" x="181.5" y="89.5" width="101" height="101" pivotX="0.5" pivotY="0.5">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Transform target="angle" value="[SECOND] % 2 == 0 ? -105 : 105">
        <Animation duration="0.4" interpolation="EASE_IN_OUT" />
      </Transform>
      <PartImage x="0" y="0" width="101" height="101">
        <Image resource="balance" />
      </PartImage>
    </Group>

    <!-- Dial with a round window cut out so the movement shows through. -->
    <Group name="dial" x="0" y="0" width="450" height="450">
      <Variant mode="AMBIENT" target="alpha" value="64" />
      <PartImage x="0" y="0" width="450" height="450">
        <Image resource="bg" />
      </PartImage>
    </Group>

    <!-- Bridge that holds the balance wheel. -->
    <PartImage x="145" y="60" width="160" height="160">
      <Image resource="top" />
    </PartImage>


    <!-- Heart rate (left window) and battery level (right window). -->
    <Group name="values" x="0" y="0" width="450" height="450">
      <Variant mode="AMBIENT" target="alpha" value="130" />
      <PartText x="104" y="206" width="44" height="38">
        <Text align="CENTER">
          <Font family="SYNC_TO_DEVICE" size="23" color="#fff5f6f8">
            <Template>%d<Parameter expression="round([HEART_RATE])" /></Template>
          </Font>
        </Text>
      </PartText>
      <PartText x="308" y="206" width="44" height="38">
        <Text align="CENTER">
          <Font family="SYNC_TO_DEVICE" size="23" color="#fff5f6f8">
            <Template>%d<Parameter expression="[BATTERY_PERCENT]" /></Template>
          </Font>
        </Text>
      </PartText>
    </Group>

    <AnalogClock x="0" y="0" width="450" height="450">
      <HourHand resource="hour" x="205" y="110" width="40" height="143"
          pivotX="0.5" pivotY="0.804">
        <Variant mode="AMBIENT" target="alpha" value="170" />
      </HourHand>
      <MinuteHand resource="minute" x="205" y="54" width="40" height="199"
          pivotX="0.5" pivotY="0.859">
        <Variant mode="AMBIENT" target="alpha" value="170" />
      </MinuteHand>
    </AnalogClock>

    <!-- Optional red seconds hand (Customize on the watch). -->
    <BooleanConfiguration id="show_seconds">
      <BooleanOption id="TRUE">
        <AnalogClock x="0" y="0" width="450" height="450">
          <SecondHand resource="second" x="205" y="38" width="40" height="234"
              pivotX="0.5" pivotY="0.799">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Sweep frequency="15" />
          </SecondHand>
        </AnalogClock>
      </BooleanOption>
      <BooleanOption id="FALSE" />
    </BooleanConfiguration>

    <PartImage x="213" y="213" width="24" height="24">
      <Image resource="cap" />
    </PartImage>

    <!-- Glass reflection. -->
    <Group name="gloss" x="0" y="0" width="450" height="450">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <PartImage x="0" y="0" width="450" height="450">
        <Image resource="gloss" />
      </PartImage>
    </Group>

  </Scene>
</WatchFace>
